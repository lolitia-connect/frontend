{
  "name": "ppanel-admin-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "node ../../scripts/write-version-lock.mjs apps/admin && next build",
    "start": "next start --port 3001",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "PLAYWRIGHT_TRANSFORM_CACHE_DIR=.tmp-e2e/transform playwright test",
    "test:e2e:report": "playwright show-report",
    "i18n:extract": "i18next-cli extract",
    "i18n:sync": "i18next-cli sync",
    "i18n:status": "i18next-cli status"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@lottiefiles/dotlottie-react": "^0.17.15",
    "@noble/curves": "^2.2.0",
    "@noble/post-quantum": "^0.6.1",
    "@sentry/nextjs": "^11.16.0",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.11.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/ui": "workspace:*",
    "ahooks": "^3.9.7",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "mlkem-wasm": "^0.0.7",
    "motion": "^12.38.0",
    "next": "^16.0.10",
    "qrcode.react": "^4.2.0",
    "radash": "^12.1.1",
    "react": "^19.2.0",
    "react-copy-to-clipboard": "^5.1.1",
    "react-dom": "^19.2.0",
    "react-turnstile": "^1.1.5",
    "swr": "^2.3.6",
    "tailwindcss": "^4.2.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
