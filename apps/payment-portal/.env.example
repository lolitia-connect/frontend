# Public Sentry DSN for this app. Set it in .env for local testing or in Netlify
# for production. Leave it empty to disable reporting. Do not add auth tokens.
NEXT_PUBLIC_SENTRY_DSN=
# Optional public release identifier, such as the deployed commit SHA.
NEXT_PUBLIC_SENTRY_RELEASE=

NEXT_PUBLIC_API_BASE_URL=https://api.ppanel.dev
NEXT_PUBLIC_API_PREFIX=
# Presets match main: below 10000 = major units; 10000 and above = legacy cents.
NEXT_PUBLIC_PAYMENT_PORTAL_AMOUNTS=10,20,50,100
# Custom input uses major units, with a minimum floor of 1.
NEXT_PUBLIC_PAYMENT_PORTAL_MIN_CUSTOM_AMOUNT=1
