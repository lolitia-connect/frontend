{
  "name": "ppanel-payment-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "biome lint src app next.config.ts vitest.config.ts vitest.setup.ts",
    "check": "biome check src app next.config.ts vitest.config.ts vitest.setup.ts",
    "typecheck": "tsc --noEmit",
