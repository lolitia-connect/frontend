    "i18n:status": "i18next-cli status"
  },
  "dependencies": {
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@hookform/resolvers": "^5.4.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query": "^5.101.0",
    "@workspace/ui": "workspace:*",
    "ahooks": "^3.9.7",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.21.0",
    "next": "^16.0.10",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.79.0",
    "react-i18next": "^16.3.5",
    "react-turnstile": "^1.1.4",
    "sonner": "^2.0.7",
