# API base URL. The browser calls the backend DIRECTLY using this value, so set
# it to the backend's public URL (in the Netlify UI for production, here for
# local development, e.g. http://127.0.0.1:8080). The backend must allow CORS
# from the site origin. There is no server-side proxy fallback.
NEXT_PUBLIC_API_BASE_URL=
# Optional path prefix prepended to /v1 and /v2 (e.g. /api). Leave empty unless
# the backend itself serves the API under that prefix; nothing strips it anymore.
NEXT_PUBLIC_API_PREFIX=

# CDN URL for static assets
NEXT_PUBLIC_CDN_URL=https://cdn.jsdmirror.com

# Enable tutorial document feature (true/false)
NEXT_PUBLIC_TUTORIAL_DOCUMENT=true

# Show landing page on home route (true/false, default: true)
# When set to false, users will be redirected to login page directly
NEXT_PUBLIC_SHOW_LANDING_PAGE=true

# Default login credentials (for development only)
NEXT_PUBLIC_USER_EMAIL=
NEXT_PUBLIC_USER_PASSWORD=
